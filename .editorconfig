root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{h,cpp}]
indent_style = space
indent_size = 4

[*.{md,ps1,xml,vcxproj,filters,slnx,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[scripts/sync-vs-layout.ps1]
charset = utf-8-bom
