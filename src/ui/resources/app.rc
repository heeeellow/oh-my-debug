#pragma code_page(65001)
#include <winres.h>
#include "app_version.h"
#include "app_info.h"

101 ICON "src\\ui\\resources\\app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OMD_VERSION_COMMA
 PRODUCTVERSION OMD_VERSION_COMMA
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", OMD_COMPANY_NAME "\0"
            VALUE "Comments", "Developer: " OMD_DEVELOPER_NAME "\0"
            VALUE "FileDescription", OMD_APP_NAME "\0"
            VALUE "FileVersion", OMD_VERSION "\0"
            VALUE "InternalName", OMD_APP_ID "\0"
            VALUE "LegalCopyright", OMD_COPYRIGHT "\0"
            VALUE "OriginalFilename", OMD_ORIGINAL_FILENAME "\0"
            VALUE "ProductName", OMD_APP_NAME "\0"
            VALUE "ProductVersion", OMD_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
